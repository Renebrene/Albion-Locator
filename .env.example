# Yandex Maps JavaScript API; client-visible after login. Restrict to the exact site origin.
YANDEX_JS_API_KEY=

# Yandex Geosuggest for SuggestView; client-visible after login. Restrict to the exact site origin.
YANDEX_SUGGEST_API_KEY=

# Server-only Yandex Geocoder key. Never return this value to the browser.
YANDEX_API_KEY=

# Optional Yandex Static API key; currently unused by the application.
YANDEX_STATIC_API_KEY=

# Optional offline data paths
# ALBION_GEO_DATA_DIR=/var/lib/albion/geo
# ALBION_BASEMAP_MBTILES=/var/lib/albion/geo/basemap.mbtiles
# ALBION_VECTOR_MBTILES=/var/lib/albion/geo/vector.mbtiles
# ALBION_USERS_DB=/var/lib/albion/users.db

# Require a password change after first login and after an admin reset (default: 1).
# ALBION_REQUIRE_PASSWORD_CHANGE=1

# Force offline defaults: local road index + local raster/vector basemap.
# ALBION_OFFLINE=1
