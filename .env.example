# Yandex Maps JavaScript API; client-visible after login. Restrict to the exact site origin.
YANDEX_JS_API_KEY=

# Yandex Geosuggest for SuggestView; client-visible after login. Restrict to the exact site origin.
YANDEX_SUGGEST_API_KEY=

# Server-only Yandex Geocoder key. Never return this value to the browser.
YANDEX_API_KEY=

# Optional Yandex Static API key; currently unused by the application.
YANDEX_STATIC_API_KEY=

# Optional offline data paths
# ALBION_GEO_DATA_DIR=/var/lib/albion/geo
# ALBION_BASEMAP_MBTILES=/var/lib/albion/geo/basemap.mbtiles
# ALBION_VECTOR_MBTILES=/var/lib/albion/geo/vector.mbtiles
# ALBION_USERS_DB=/var/lib/albion/users.db

# Require a password change after first login and after an admin reset (default: 1).
# ALBION_REQUIRE_PASSWORD_CHANGE=1

# Security: auto|always|never. Auto uses X-Forwarded-Proto / HTTPS.
# ALBION_COOKIE_SECURE=auto
# CSRF double-submit is enabled by default; disable only for API integrations/tests.
# ALBION_CSRF=1
# FastAPI docs are closed by default.
# ALBION_ENABLE_DOCS=0
# Override CSP only if a provider is blocked; "off" disables the header.
# ALBION_CSP_POLICY=
# Additional allowed public origins for the Origin check (comma-separated).
# ALBION_ALLOWED_ORIGINS=https://locator.example

# Rate limits (0 disables the limiter).
# The general /api/* limit is OFF by default: the service is used locally or over
# VPN, and one session of chainage-slider work costs dozens of API calls.
# Enable it explicitly for an internet-exposed deployment.
# ALBION_API_RATE_LIMIT=300
# ALBION_API_RATE_WINDOW=60
# Login attempts stay limited even with the general limit off — they guard
# against password guessing.
# ALBION_LOGIN_RATE_LIMIT=20
# ALBION_LOGIN_RATE_WINDOW=60
# ALBION_LOGIN_MAX_FAILURES=5
# ALBION_LOGIN_WINDOW_SECONDS=900
# ALBION_LOGIN_LOCKOUT_SECONDS=900

# Structured logs (json|plain) and minimum level.
# ALBION_LOG_FORMAT=json
# ALBION_LOG_LEVEL=INFO

# Prometheus /metrics: optional shared token for reverse-proxy scraping.
# Without a token /metrics is loopback-only.
# ALBION_METRICS_TOKEN=

# SKDF WFS layer with roads and official chainage. The provider renames layers
# without notice (27.10.2026: lyr_road_by_value_line -> lyr_road_by_value), so the
# app tries this name first, then the built-in candidates. Set it explicitly when
# the layer is renamed again.
# ALBION_WFS_ROAD_LAYER=skdf_open:lyr_road_by_value

# Upstream WFS/Overpass/Yandex retries and in-memory TTL cache (seconds, 0=off).
# ALBION_UPSTREAM_RETRY_ATTEMPTS=3
# ALBION_UPSTREAM_CACHE_TTL=300

# Force offline defaults: local road index + local raster/vector basemap.
# ALBION_OFFLINE=1
# Map source default: vector|local|external. Without it, an installed local
# basemap is preferred and OSM 403/tile errors fall back automatically.
# ALBION_DEFAULT_MAP_SOURCE=vector
