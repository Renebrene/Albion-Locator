# Yandex Maps JavaScript API; client-visible after login. Restrict to the exact site origin.
YANDEX_JS_API_KEY=

# Yandex Geosuggest for SuggestView; client-visible after login. Restrict to the exact site origin.
YANDEX_SUGGEST_API_KEY=

# Server-only Yandex Geocoder key. Never return this value to the browser.
YANDEX_API_KEY=

# Optional Yandex Static API key; currently unused by the application.
YANDEX_STATIC_API_KEY=
